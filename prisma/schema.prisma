generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String?       @unique
  phone           String?       @unique
  password        String?
  image           String?
  role            String        @default("USER")
  roles           String        @default("USER") // 逗号分隔多身份：USER,TEACHER,INSTITUTION
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviews         Review[]
  favorites       Favorite[]
  feedbacks       Feedback[]
  feedbackReplies FeedbackReply[]
  teacher         Teacher?      @relation("UserTeacher")
  teacherReviews  TeacherReview[]
  conversationsAsStudent Conversation[] @relation("ConvStudent")
  conversationsAsPeer   Conversation[] @relation("ConvPeer")
  sentMessages         Message[]      @relation("MsgSender")
  questions       Question[]
  answers         Answer[]
  institutionId   String?
  ownedInstitution Institution? @relation("InstitutionOwner")
  notifications   Notification[]

  @@index([role])
}

model Category {
  id       String   @id @default(cuid())
  name     String
  slug     String   @unique
  icon     String?
  parentId String?
  parent   Category? @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  courses  Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Institution {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  cover       String?
  images      String?
  description String?
  address     String?
  district    String?
  phone       String?
  website     String?
  status      String       @default("PENDING")
  featured    Boolean      @default(false)
  adLevel     String       @default("FREE")
  rating      Float        @default(0)
  reviewCount Int          @default(0)
  courseCount Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     Course[]
  reviews     Review[]
  favorites   Favorite[]
  contacts    Contact[]
  ads         Advertisement[]
  adOrders    AdOrder[]
  currentTeachers   Teacher[]           @relation("TeacherCurrentInstitution")
  teacherEmployments TeacherEmployment[] @relation("TeacherEmploymentInstitution")
  campuses    Campus[]    @relation("InstitutionCampuses")
  ownerId     String?      @unique
  owner       User?        @relation("InstitutionOwner", fields: [ownerId], references: [id])

  @@index([status])
  @@index([district])
  @@index([rating])
}

// ──────────────────── 校区（一个机构可有多个校区） ────────────────────
// 每个校区可单独配置地址、电话、图片，并解析经纬度用于地图展示/就近筛选。
// lng/lat 由高德地理编码根据 address 自动解析，也可在表单中拖拽微调。
model Campus {
  id           String      @id @default(cuid())
  institutionId String
  institution  Institution @relation("InstitutionCampuses", fields: [institutionId], references: [id], onDelete: Cascade)
  name         String // 校区名称，如「思明校区」「软件园校区」
  address      String? // 详细地址
  district     String? // 区域（复用 DISTRICTS：思明/湖里/集美/海沧/同安/翔安)
  phone        String? // 校区独立联系电话
  images       String? // 校区图片，逗号分隔多个 URL
  lng          Float? // 经度（高德坐标系 GCJ-02）
  lat          Float? // 纬度（高德坐标系 GCJ-02）
  isMain       Boolean     @default(false) // 是否为主校区
  sortOrder    Int         @default(0) // 展示排序，小在前
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([institutionId])
  @@index([district])
}

model Course {
  id            String     @id @default(cuid())
  title         String
  slug          String
  description   String?
  price         String?
  originalPrice String?
  cover         String?
  tags          String?
  institutionId String
  categoryId    String
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id])
  category      Category   @relation(fields: [categoryId], references: [id])
  reviews       Review[]
  favorites     Favorite[]
  contacts      Contact[]

  @@unique([institutionId, slug])
  @@index([categoryId])
  @@index([status])
}

model Review {
  id            String      @id @default(cuid())
  rating        Int
  content       String?
  userId        String
  institutionId String?
  courseId      String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  institution   Institution? @relation(fields: [institutionId], references: [id])
  course        Course?      @relation(fields: [courseId], references: [id])

  @@index([institutionId])
  @@index([courseId])
}

model Favorite {
  id            String      @id @default(cuid())
  userId        String
  courseId      String?
  institutionId String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  course        Course?      @relation(fields: [courseId], references: [id])
  institution   Institution? @relation(fields: [institutionId], references: [id])

  @@unique([userId, courseId])
  @@unique([userId, institutionId])
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?
  content     String?
  cover       String?
  category    String?
  tags        String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
}

model Advertisement {
  id            String      @id @default(cuid())
  title         String
  image         String?
  link          String?
  position      String
  institutionId String?
  startDate     DateTime?
  endDate       DateTime?
  active        Boolean     @default(true)
  clicks        Int         @default(0)
  views         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution? @relation(fields: [institutionId], references: [id])

  @@index([position])
  @@index([active])
}

model AdPlan {
  id          String    @id @default(cuid())
  name        String
  level       String    @unique
  price       Float
  duration    Int
  features    String
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      AdOrder[]

  @@index([active])
}

model AdOrder {
  id            String       @id @default(cuid())
  institutionId String
  planId        String
  amount        Float
  status        String       @default("PENDING")
  startDate     DateTime?
  endDate       DateTime?
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id])
  plan          AdPlan       @relation(fields: [planId], references: [id])

  @@index([institutionId])
  @@index([status])
}

model Contact {
  id        String   @id @default(cuid())
  name      String?
  phone     String
  message   String?
  courseId  String?
  course    Course?      @relation(fields: [courseId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([courseId])
}

model SmsConfig {
  id              String   @id @default(cuid())
  provider        String   @default("dev") // dev | aliyun | tencent
  enabled         Boolean  @default(false)
  // 阿里云短信
  accessKeyId     String?
  accessKeySecret String?
  signName        String?
  templateCode    String?
  // 腾讯云短信
  secretId        String?
  secretKey       String?
  sdkAppId        String?
  templateId      String?
  region          String?  @default("ap-guangzhou")
  endpoint        String?  @default("dysmsapi.aliyuncs.com")
  updatedAt       DateTime @updatedAt
}

model EmailConfig {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false) // 是否启用真实 SMTP 发送（否则开发模式打印到控制台）
  host      String? // SMTP 主机，如 smtp.qq.com / smtp.163.com / smtp.exmail.qq.com
  port      Int      @default(465) // 465=SSL，587/25=STARTTLS
  secure    Boolean  @default(true) // true 使用 SSL(465)，false 使用 STARTTLS(587/25)
  user      String? // 发件账号
  pass      String? // 授权码 / 密码
  from      String? // 发件人显示，如 "厦门培训网 <noreply@xmpx.cn>"
  updatedAt DateTime @updatedAt
}

// 验证码持久化存储（替代原内存 Map，兼容 Vercel Serverless 多实例）
// type: SMS(手机验证码登录) | EMAIL_RESET(邮箱找回密码) | EMAIL_BIND(换绑邮箱)
model VerificationCode {
  id        String   @id @default(cuid())
  type      String
  target    String // 手机号或邮箱（邮箱统一小写存储）
  code      String
  attempts  Int      @default(0) // 已尝试次数，达上限需重新获取
  expiresAt DateTime
  createdAt DateTime @default(now()) // 兼作发送冷却时间戳

  @@unique([type, target])
  @@index([target])
}

// ──────────────────── 统一消息通知（消息中心） ────────────────────
// type 枚举：
//   MESSAGE          — 收到私信
//   CONTACT          — 收到咨询/报名
//   FEEDBACK_REPLY   — 留言被回复
//   REVIEW           — 收到评价
//   QUESTION_APPROVED — 提问审核通过
//   ANSWER_APPROVED  — 回复被审核通过（通知提问者）
//   ADMIN_REPLY_QUESTION — 管理员回复了提问
model Notification {
  id          String    @id @default(cuid())
  recipientId String    // 接收者 userId
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String    // 见上方枚举
  title       String    // 通知标题（简短）
  body        String?   // 通知正文（可选，详情页展示）
  relatedType String?   // 关联实体类型：Message|Contact|Feedback|Review|Question|Answer|Conversation
  relatedId   String?   // 关联实体 ID（用于跳转）
  readAt      DateTime? // 已读时间，null = 未读
  createdAt   DateTime  @default(now())

  @@index([recipientId])
  @@index([recipientId, readAt])
  @@index([createdAt])
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String?
  authorName  String? // 展示用昵称（取自用户 name/手机号脱敏），公开可见
  type        String   @default("OTHER") // INSTITUTION | COURSE | OTHER
  targetId    String? // 关联机构/课程 id
  targetName  String? // 关联对象名称（冗余存储，便于前台展示）
  content     String
  status      String   @default("PENDING") // PENDING | RESOLVED | TAKEDOWN | REJECTED
  adminReply  String? // 管理员处理结果/回复（公开可见）
  isPublic    Boolean  @default(true) // 是否在前台公开展示
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
  replies     FeedbackReply[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String?              // null = 匿名回复（暂不支持匿名回复，预留）
  content    String
  createdAt  DateTime @default(now())
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id])

  @@index([feedbackId])
  @@index([createdAt])
}

model Teacher {
  id                   String       @id @default(cuid())
  userId               String       @unique
  user                 User         @relation("UserTeacher", fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  title                String?      // 头衔，如 "资深雅思讲师"
  bio                  String?      // 简介
  expertise            String?      // 擅长科目/课程，逗号分隔，如 "雅思,托福,考研英语"
  avatar               String?
  district             String?      // 区域，复用 DISTRICTS
  currentInstitutionId String?      // 当前所属机构
  currentInstitution   Institution? @relation("TeacherCurrentInstitution", fields: [currentInstitutionId], references: [id])
  slug                 String       @unique
  rating               Float        @default(0)  // 冗余，写 TeacherReview 时重算
  reviewCount          Int          @default(0)  // 冗余
  status               String       @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  employments          TeacherEmployment[]
  reviews              TeacherReview[]

  @@index([district])
  @@index([status])
  @@index([rating])
}

model TeacherEmployment {
  id            String      @id @default(cuid())
  teacherId     String
  teacher       Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation("TeacherEmploymentInstitution", fields: [institutionId], references: [id], onDelete: Cascade)
  title         String?     // 任职头衔，如 "教学主管"
  startDate     DateTime    @default(now())
  endDate       DateTime?   // 空 = 至今
  createdAt     DateTime    @default(now())

  @@index([teacherId])
  @@index([institutionId])
}

model TeacherReview {
  id         String   @id @default(cuid())
  rating     Int                      // 1~5
  content    String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  status     String   @default("RESOLVED") // PENDING|RESOLVED|TAKEDOWN|REJECTED
  isPublic   Boolean  @default(true)       // 默认公开；管理员下架置 false
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([teacherId])
  @@index([userId])
  @@index([status])
}

model Conversation {
  id           String   @id @default(cuid())
  studentId    String // 学员 userId（固定一端）
  student      User     @relation("ConvStudent", fields: [studentId], references: [id], onDelete: Cascade)
  peerType     String // TEACHER | INSTITUTION（对方身份类型）
  peerUserId   String // 对方 userId（老师=teacher.userId；机构=institution.ownerId）
  peer         User     @relation("ConvPeer", fields: [peerUserId], references: [id], onDelete: Cascade)
  peerEntityId String? // 对方实体 id：teacher.id 或 institution.id（用于跳转/展示）
  subject      String? // 会话主题（可选）
  lastMessage  String? // 最后一条消息预览（冗余，优化列表）
  lastAt       DateTime @default(now()) // 最后活跃时间（冗余，排序用）
  status       String   @default("OPEN") // OPEN | CLOSED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     Message[]

  @@index([studentId])
  @@index([peerUserId])
  @@index([peerType])
  @@index([lastAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String // 发送者 userId
  sender         User     @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole     String // STUDENT | TEACHER | INSTITUTION（冗余，便于展示样式）
  content        String
  readAt         DateTime? // 已读时间（接收方打开会话时标记）
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// ──────────────────── 问答社区（人工审核防广告） ────────────────────

model Question {
  id         String   @id @default(cuid())
  title      String
  content    String
  category   String   // welfare | review | policy | subsidy | other
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | TAKEDOWN
  isPublic   Boolean  @default(false)      // 审核通过并上架才公开展示
  adminReply String? // 管理员回复/处理结果（公开可见）
  views      Int      @default(0)
  slug       String?  @unique            // SEO 友好 slug（由标题生成）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  answers    Answer[]

  @@index([category])
  @@index([status])
  @@index([isPublic])
  @@index([createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String?  // 匿名回复时为空
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?  // 展示昵称（取自用户 name 或脱敏手机号）
  content    String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  isPublic   Boolean  @default(false)      // 审核通过才公开展示
  isBest     Boolean  @default(false)
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
  @@index([status])
  @@index([isPublic])
}

/// 百度搜索资源平台推送日志（API 提交 / sitemap / 手动）
model BaiduPushLog {
  id          String   @id @default(cuid())
  type        String   @default("api")       // api | sitemap | manual
  urls        String   // 推送的 URL 列表（换行分隔，便于查看）
  count       Int      @default(0)           // 本次推送 URL 数量
  success     Int      @default(0)           // 成功收录数
  remain      Int?                          // 当日剩余配额
  error       String?                        // 错误信息
  response    String?                       // 原始响应 JSON
  triggeredBy String  @default("manual")     // manual | cron | api
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}
