generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String?       @unique
  phone           String?       @unique
  password        String?
  image           String?
  role            String        @default("USER")
  wechatOpenId    String?       @unique
  wechatUnionId   String?
  wechatNickname  String?
  wechatAvatar    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviews         Review[]
  favorites       Favorite[]
  feedbacks       Feedback[]
  feedbackReplies FeedbackReply[]
  institutionId   String?
  ownedInstitution Institution? @relation("InstitutionOwner")

  @@index([role])
}

model Category {
  id       String   @id @default(cuid())
  name     String
  slug     String   @unique
  icon     String?
  parentId String?
  parent   Category? @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  courses  Course[]

  @@index([parentId])
}

model Institution {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  cover       String?
  images      String?
  description String?
  address     String?
  district    String?
  phone       String?
  website     String?
  status      String       @default("PENDING")
  featured    Boolean      @default(false)
  adLevel     String       @default("FREE")
  rating      Float        @default(0)
  reviewCount Int          @default(0)
  courseCount Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     Course[]
  reviews     Review[]
  favorites   Favorite[]
  contacts    Contact[]
  ads         Advertisement[]
  adOrders    AdOrder[]
  ownerId     String?      @unique
  owner       User?        @relation("InstitutionOwner", fields: [ownerId], references: [id])

  @@index([status])
  @@index([district])
  @@index([rating])
}

model Course {
  id            String     @id @default(cuid())
  title         String
  slug          String
  description   String?
  price         String?
  originalPrice String?
  cover         String?
  tags          String?
  institutionId String
  categoryId    String
  status        String     @default("ACTIVE")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id])
  category      Category   @relation(fields: [categoryId], references: [id])
  reviews       Review[]
  favorites     Favorite[]
  contacts      Contact[]

  @@unique([institutionId, slug])
  @@index([categoryId])
  @@index([status])
}

model Review {
  id            String      @id @default(cuid())
  rating        Int
  content       String?
  userId        String
  institutionId String?
  courseId      String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  institution   Institution? @relation(fields: [institutionId], references: [id])
  course        Course?      @relation(fields: [courseId], references: [id])

  @@index([institutionId])
  @@index([courseId])
}

model Favorite {
  id            String      @id @default(cuid())
  userId        String
  courseId      String?
  institutionId String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  course        Course?      @relation(fields: [courseId], references: [id])
  institution   Institution? @relation(fields: [institutionId], references: [id])

  @@unique([userId, courseId])
  @@unique([userId, institutionId])
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?
  content     String?
  cover       String?
  category    String?
  tags        String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
}

model Advertisement {
  id            String      @id @default(cuid())
  title         String
  image         String?
  link          String?
  position      String
  institutionId String?
  startDate     DateTime?
  endDate       DateTime?
  active        Boolean     @default(true)
  clicks        Int         @default(0)
  views         Int         @default(0)
  createdAt     DateTime    @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id])

  @@index([position])
  @@index([active])
}

model AdPlan {
  id          String    @id @default(cuid())
  name        String
  level       String    @unique
  price       Float
  duration    Int
  features    String
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  orders      AdOrder[]

  @@index([active])
}

model AdOrder {
  id            String       @id @default(cuid())
  institutionId String
  planId        String
  amount        Float
  status        String       @default("PENDING")
  startDate     DateTime?
  endDate       DateTime?
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id])
  plan          AdPlan       @relation(fields: [planId], references: [id])

  @@index([institutionId])
  @@index([status])
}

model Contact {
  id        String   @id @default(cuid())
  name      String?
  phone     String
  message   String?
  courseId  String?
  course    Course?      @relation(fields: [courseId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt DateTime @default(now())

  @@index([institutionId])
  @@index([courseId])
}

model SmsConfig {
  id              String   @id @default(cuid())
  provider        String   @default("dev") // dev | aliyun | tencent
  enabled         Boolean  @default(false)
  // 阿里云短信
  accessKeyId     String?
  accessKeySecret String?
  signName        String?
  templateCode    String?
  // 腾讯云短信
  secretId        String?
  secretKey       String?
  sdkAppId        String?
  templateId      String?
  region          String?  @default("ap-guangzhou")
  endpoint        String?  @default("dysmsapi.aliyuncs.com")
  updatedAt       DateTime @updatedAt
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String?
  authorName  String? // 展示用昵称（取自用户 name/手机号脱敏），公开可见
  type        String   @default("OTHER") // INSTITUTION | COURSE | OTHER
  targetId    String? // 关联机构/课程 id
  targetName  String? // 关联对象名称（冗余存储，便于前台展示）
  content     String
  status      String   @default("PENDING") // PENDING | RESOLVED | TAKEDOWN | REJECTED
  adminReply  String? // 管理员处理结果/回复（公开可见）
  isPublic    Boolean  @default(true) // 是否在前台公开展示
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id])
  replies     FeedbackReply[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String?              // null = 匿名回复（暂不支持匿名回复，预留）
  content    String
  createdAt  DateTime @default(now())
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id])

  @@index([feedbackId])
  @@index([createdAt])
}
